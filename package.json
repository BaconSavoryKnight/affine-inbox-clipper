{
  "name": "affine-inbox-clipper",
  "version": "1.0.1",
  "description": "Firefox clipper that files web clips into an AFFiNE Inbox folder",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run.mjs",
    "lint": "web-ext lint -s dist",
    "start": "web-ext run -s dist",
    "package": "web-ext build -s dist --overwrite-dest"
  },
  "author": "RJ Bacon",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fractional-indexing": "^4.0.0",
    "socket.io-client": "^4.8.4",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "socket.io": "^4.8.4",
    "web-ext": "^10.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BaconSavoryKnight/affine-inbox-clipper"
  },
  "keywords": [
    "affine",
    "firefox",
    "web-clipper",
    "webextension",
    "pkm"
  ]
}
